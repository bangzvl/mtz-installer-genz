<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Untuk memuat katalog & mengunduh tema dari tab Jelajah -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Agar bisa mendeteksi aplikasi Tema bawaan MIUI/HyperOS (Android 11+) -->
    <queries>
        <package android:name="com.android.thememanager" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MtzInstaller">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Buka file .mtz langsung dari file manager -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-mtz" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
